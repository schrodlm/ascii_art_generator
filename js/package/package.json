{
  "name": "clascii",
  "version": "0.1.1",
  "description": "Turns pictures into ASCII art, with tables of characters or braille. Compiled from Scala with Scala.js.",
  "keywords": [
    "ascii-art",
    "ascii",
    "braille",
    "image",
    "camera",
    "scala-js"
  ],
  "license": "MIT",
  "author": "Matěj Schrödl",
  "homepage": "https://github.com/schrodlm/clascii#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schrodlm/clascii.git",
    "directory": "js/package"
  },
  "bugs": "https://github.com/schrodlm/clascii/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./main.mjs"
    }
  },
  "files": [
    "index.d.ts",
    "main.mjs"
  ],
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
